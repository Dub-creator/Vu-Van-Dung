private void txtMaSV_Leave(object sender, EventArgs e)
{
    string maSV = txtMaSV.Text.Trim();
    if (string.IsNullOrEmpty(maSV)) return;

    // Giả sử có hàm tìm kiếm sinh viên trong CSDL/List theo mã
    SinhVien sv = TimSinhVienTheoMa(maSV); 

    if (sv != null)
    {
        // Tồn tại: hiển thị thông tin lên các điều khiển
        txtHoTen.Text = sv.HoTen;
        dtpNgaySinh.Value = sv.NgaySinh;
        // ... gán các trường khác (Giới tính, Email, Điểm, Lớp...)
        
        // Disable chức năng nhập/thêm, enable Sửa, Xóa
        txtMaSV.Enabled = false; // khóa mã lại không cho sửa khóa chính
        btnThem.Enabled = false;
        btnSua.Enabled = true;
        btnXoa.Enabled = true;
    }
    else
    {
        // Chưa tồn tại: xóa trắng các control khác, bật chức năng nhập
        ClearInputFields();
        btnThem.Enabled = true;
        btnSua.Enabled = false;
        btnXoa.Enabled = false;
    }
}


private void btnLamMoi_Click(object sender, EventArgs e)
{
    // Xóa trắng toàn bộ ô nhập liệu
    txtMaSV.Clear();
    txtMaSV.Enabled = true; // Cho phép nhập lại mã mới
    ClearInputFields();

    // Thiết lập lại trạng thái các Button
    btnThem.Enabled = true;
    btnSua.Enabled = false;
    btnXoa.Enabled = false;

    // Chuyển tiêu điểm về txtMaSV
    txtMaSV.Focus();
}

private void btnXoa_Click(object sender, EventArgs e)
{
    // Hiển thị hộp thoại cảnh báo trước khi thực hiện chức năng nguy hiểm
    DialogResult result = MessageBox.Show(
        "Bạn có chắc chắn muốn xóa sinh viên có mã " + txtMaSV.Text + " không?", 
        "Xác nhận xóa", 
        MessageBoxButtons.YesNo, 
        MessageBoxIcon.Warning
    );

    if (result == DialogResult.Yes)
    {
        // Thực hiện logic xóa trong cơ sở dữ liệu
        // Sau đó gọi lại nút làm mới
        btnLamMoi_Click(sender, e);
        MessageBox.Show("Đã xóa thành công!", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Information);
    }
}

